# =============================================================================
# .env.example  (template for local configuration — copy to .env)
# =============================================================================
# This is the committed, secret-free reference of EVERY environment variable the
# stack reads (via pydantic-settings in each service). Copy it to `.env` and
# fill in real values for local dev; `.env` itself is gitignored/dockerignored
# so secrets never get committed or baked into an image.
#
# NOTE the URLs here use `localhost` because this file targets the Docker-free
# dev loop (honcho / Procfile.dev), where every service is a process on your
# machine. Under docker-compose the same vars are set to Docker DNS names
# (http://content:8001, http://ai:8002) instead — see docker-compose.yml.

# Shared bearer token the services present to one another. rpc's ServiceClient
# injects it as the token_provider; the receiving service maps a bad/missing
# token to AuthError -> HTTP 401.
SERVICE_TOKEN=dev-token

# Where callers reach the content service (used by ai for its tool-use loop and
# by web for /work pages).
CONTENT_URL=http://localhost:8001

# Where the web BFF reaches the ai service (used by the /chat route).
AI_URL=http://localhost:8002

# Which LLM backend the ai service uses. "fake" selects the deterministic
# FakeLLMProvider (default) so the stack runs fully offline with NO API key.
# Switch to the real provider to talk to Claude (then set LLM_API_KEY below).
LLM_PROVIDER=fake

# API key for the real provider. Left blank because the default "fake" provider
# needs none; required only when LLM_PROVIDER selects the real AnthropicProvider.
LLM_API_KEY=

# Optional base URL override for the LLM API. Blank = the SDK's default endpoint.
# Set this to route through the Vercel AI Gateway (or any Anthropic-compatible
# proxy). Demonstrates the base_url injection pattern at the LLM layer.
LLM_BASE_URL=

# Which Claude model the real provider requests. Ignored by the fake provider.
LLM_MODEL=claude-haiku-4-5-20251001
